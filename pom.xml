<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>ws.lumo</groupId>
    <artifactId>lumo-api</artifactId>
    <version>1.2.1-SNAPSHOT</version>
    <name>lumo-api</name>
    <description>Shared API and Domain objects for Lumo.ws services</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.0.2</spring-ai.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

    <dependencies>
        <!--
         This dependency is required because ToolSpecification uses JsonNode.
         It's in the 'compile' scope (default) so that any module using lumo-api
         will also get this dependency transitively.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!--
         KORJAUS: Lisätään Spring Data -riippuvuudet 'provided'-skoopilla.
         Vaikka pääsovellus tarjoaa nämä, ne ovat välttämättömiä käännösvaiheessa,
         jotta domain-luokkien @Id- ja @Document-annotaatiot tunnistetaan.
        -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-mongodb</artifactId>
            <!-- This scope is managed by the Spring Boot parent POM -->
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>
        <!-- KORJAUS: Lisätään spring-web, jotta MultipartFile-luokka löytyy.
             Skooppi on 'provided', koska käyttävä sovellus (lumo-service) tarjoaa tämän ajonaikaisesti. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
    </dependencies>

    <!-- Tuodaan Spring AI:n riippuvuuksien hallinta (BOM), jotta versiot ovat yhdenmukaisia. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- KORJAUS: Varmistetaan, että Lombok-annotaatioprosessori on konfiguroitu oikein. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- KORJAUS: Palautetaan Javadoc-plugin, jotta javadoc.jar-tiedosto luodaan `package`-vaiheessa. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- KORJAUS: Lisätään lähdekoodit mukaan pakettiin. Tämä on hyvä käytäntö kirjastoille. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>