<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Määritellään projektin perustiedot. Ei tarvita parent-määritystä,
         koska tämä on kevyt, itsenäinen kirjasto. -->
    <groupId>ws.lumo</groupId>
    <artifactId>lumo-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>lumo-api</name>
    <description>Shared API definitions and DTOs for the Lumo Platform</description>

    <properties>
        <!-- Määritellään Spring Bootin versio, jotta voimme käyttää sen versiohallintaa.
             Tämän tulisi vastata muiden moduulien käyttämää versiota. -->
        <spring-boot.version>3.5.6</spring-boot.version>
        <!-- Määritetään Java-kääntäjän lähde- ja kohdeversio.
             Tämä on välttämätöntä, koska emme käytä spring-boot-parent-määritystä. -->
        <maven.compiler.source>23</maven.compiler.source>
        <maven.compiler.target>23</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Lisätään Lombok, jotta voimme vähentää boilerplate-koodia DTO-luokissa.
             Skooppi 'provided' varmistaa, ettei se päädy lopulliseen pakettiin,
             koska sitä tarvitaan vain käännösaikana. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Lisätään Jackson-annotaatiot, jotta voimme tarvittaessa ohjata
             DTO-luokkien JSON-serialisointia (esim. @JsonProperty). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>

    <!-- Tuodaan Spring Bootin riippuvuuksien hallinta (BOM - Bill of Materials).
         Tämä ei lisää yhtään riippuvuutta, mutta se määrittelee versiot
         yleisille kirjastoille, kuten Lombok ja Jackson, joten meidän ei tarvitse
         määritellä niitä itse. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>